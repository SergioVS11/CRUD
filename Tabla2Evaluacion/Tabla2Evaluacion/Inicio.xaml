<Page x:Class="Tabla2Evaluacion.Inicio"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Tabla2Evaluacion"
      mc:Ignorable="d" 
      d:DesignHeight="568" d:DesignWidth="800"
      Title="Inicio" Background="#242424">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                
                <ResourceDictionary Source="Diccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Content="_" Width="23" Height="23" Margin="0,0,0,0" Style="{StaticResource BotonVerdeRedondo}" Click="MinimizarVentana_Click"/>
            <Button Content="X" Width="23" Height="23" Margin="10"  Style="{StaticResource BotonVerdeRedondo}" Click="Cerrar_Click"/>
        </StackPanel>
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="85,20,0,0" >
                <Image Source="Images/Vector (5).png" Width="31" Height="26" Margin="5" />
                <TextBlock Text="INICIO" Foreground="#5DB85B" FontWeight="Bold"  VerticalAlignment="Bottom"
                         Margin="5,0,0,0" FontSize="16"/>
            </StackPanel>

            
        </Grid>

       
        <Grid Margin="10,80,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="PRODUCTOS" Foreground="#5DB85B" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="10,0,0,0" VerticalAlignment="Top" FontSize="16"/>
            <TextBlock Text="CATEGORÍA" Foreground="#5DB85B" FontWeight="Bold" 
                       HorizontalAlignment="Center" Grid.Column="1" Margin="0,0,90,0" VerticalAlignment="Top" FontSize="16"/>

            <Border BorderBrush="#5DB85B" BorderThickness="1" Margin="40,30,5,15">
                <DataGrid  x:Name="dgProductos" Background="Transparent"/>
            </Border>
            <Border BorderBrush="#5DB85B" BorderThickness="1" Margin="-5,30,40,15" Grid.Column="1">
                <DataGrid x:Name="dgCategorias" Background="Transparent"/>
            </Border>
           
        </Grid>
    </Grid>
</Page>
