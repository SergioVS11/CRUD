<Page x:Class="Tabla2Evaluacion.Borrar"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Tabla2Evaluacion"
      mc:Ignorable="d" 
      d:DesignHeight="568" d:DesignWidth="800"
      Title="Borrar"
      Background="#242424">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="Diccionario.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" ></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="70*"></RowDefinition>
            <RowDefinition Height="70*"></RowDefinition>
            <RowDefinition Height="245*"></RowDefinition>
            <RowDefinition Height="380*"></RowDefinition>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Grid.Column="1">
            <Button Content="_" Width="19" Height="19" Margin="0,0,0,0" Style="{StaticResource BotonVerdeRedondo}"  Click="MinimizarVentana_Click"/>
            <Button Content="X" Width="19" Height="19" Margin="10"  Style="{StaticResource BotonVerdeRedondo}" Click="Cerrar_Click"/>
        </StackPanel>


        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Center"  Margin="0,0,125,0"  Grid.Column="0" Grid.Row="1">
            <Image Source="Images/papeleraVerde.png" Width="28" Height="25" Margin="0,0,10,0" />
            <TextBlock Style="{StaticResource LetrasPeq}" VerticalAlignment="Center" Margin="0,10,0,0" Height="16" Width="92" FontSize="16"><Run Language="es-es" Text="BORRAR"/></TextBlock>
        </StackPanel>


        <StackPanel Orientation="Vertical" HorizontalAlignment="Center"   Grid.Column="0" Grid.Row="2">
            <TextBlock Style="{StaticResource LetrasPeq}" FontSize="16" Margin="0,10,0,0"><Run Text="Producto"/><LineBreak/><Run/></TextBlock>
            <TextBox x:Name="txtEliminarProducto" Style="{StaticResource LineaEscribir}" Width="178" Margin="0,-15,0,0"/>

        </StackPanel>



        <Button Click="EliminarProducto_Click"  Style="{StaticResource Botonredondomenus}" Content="Borrar" Margin="0,40,0,0" Grid.Column="1" Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Left"/>
        

        <StackPanel Grid.Column="0" Grid.Row="3">
            <TextBlock Text="PRODUCTOS" Foreground="#5DB85B" FontWeight="Bold" 
   HorizontalAlignment="Center" Margin="50,0,0,5" VerticalAlignment="Top" FontSize="16"/>
            <Border BorderBrush="#5DB85B" BorderThickness="1" Height="230" Margin="80,0,0,0">
                <DataGrid x:Name="dgProductos" Background="Transparent" Margin="0,0,0,0" ></DataGrid>
            </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="3">
            <TextBlock Text="CATEGORÍA" Foreground="#5DB85B" FontWeight="Bold" 
    HorizontalAlignment="Center" Grid.Column="1" Margin="0,0,90,5" VerticalAlignment="Top" FontSize="16"/>
            <Border BorderBrush="#5DB85B" BorderThickness="1"  Grid.Column="1" Height="230" Margin="0,0,80,0" >
                <DataGrid x:Name="dgCategorias" Background="Transparent" Margin="0,0,0,0"></DataGrid>
            </Border>
        </StackPanel>

    </Grid>
</Page>
